; Internal Beyond · Windows installer (Inno Setup 6)
; ---------------------------------------------------------------------------
; P7 · Release packaging. Per-user, no UAC, no admin rights, no Node.js
; prerequisite, no console window, single user-facing entry point.
;
; Build with:  powershell -NoProfile -ExecutionPolicy Bypass -File scripts\build-installer.ps1
; or directly: ISCC.exe /DStagingDir="<abs staging>" /DAppVersion="<x.y.z>" installer\InternalBeyond.iss
; Test-only build: the build script must pass /DInstallerTestMode=1. The test
; identity below is deterministic and is never a production release identity.
;
; Design rules (do not violate):
;   * The payload comes from the whitelist manifest (scripts/release-manifest.js)
;     staged by the build script — never from the repository directly.
;   * No PATH changes, no registry beyond the uninstall entry, no services,
;     no drivers, no firewall rules, no scheduled tasks.
;   * The only user-visible entry point is "InternalBeyond" (Start menu + optional
;     desktop icon). Development .cmd launchers are not packaged.
;   * A running InternalBeyond is stopped through its own control surface first
;     (tools\ib-stop.js); unrelated node.exe processes are never touched.
; ---------------------------------------------------------------------------

; AppVersion has exactly one source: the repository VERSION file. The build
; script reads it and passes /DAppVersion=... so nothing here is hand-written.
; A direct ISCC run without the define fails loudly instead of guessing.
#ifndef AppVersion
  #error AppVersion is not defined. Build with scripts\build-installer.ps1 (reads VERSION), or pass /DAppVersion=<x.y.z>.
#endif
#ifndef StagingDir
  #define StagingDir AddBackslash(SourcePath) + "..\dist\staging"
#endif
#ifndef OutputDir
  #define OutputDir AddBackslash(SourcePath) + "..\dist"
#endif

#define ProductionAppId "{{78B427F6-A48F-4443-86D5-2F50DC899D07}"
; TEST ONLY — NEVER SHIP AS PRODUCTION IDENTITY.
#define TestOnlyAppId "{{A4D9E7B3-1F86-4C2A-9D57-6B3E1C8F0A24}"
#define ProductionAppName "InternalBeyond"
#define TestOnlyAppName "InternalBeyond Installer Smoke Test"
#define ProductionInstallDirectoryName "InternalBeyond"
#define TestOnlyInstallDirectoryName "InternalBeyond-Installer-Smoke-Test"
#define ProductionOutputBaseName "InternalBeyond"
#define TestOnlyOutputBaseName "InternalBeyond-Installer-Smoke-Test"
#ifdef InstallerTestMode
  #define AppIdValue TestOnlyAppId
  #define AppName TestOnlyAppName
  #define AppPublisher "InternalBeyond (Test Only)"
  #define InstallDirectoryName TestOnlyInstallDirectoryName
  #define OutputBaseName TestOnlyOutputBaseName
#else
  #define AppIdValue ProductionAppId
  #define AppName ProductionAppName
  #define AppPublisher "InternalBeyond"
  #define InstallDirectoryName ProductionInstallDirectoryName
  #define OutputBaseName ProductionOutputBaseName
#endif
#define AppURL "https://github.com/yydye/InternalBeyond"
#define WebView2AppGuid "{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
#define WebView2BootstrapUrl "https://go.microsoft.com/fwlink/p/?LinkId=2124703"
#define StopHelper "ib-stop.js"
; The canonical list of files this release owns, generated by the build from the
; staged payload. It ships INSIDE the payload (so a 1.0.5 root carries the record
; of what 1.0.5 owns, and the NEXT upgrade can diff against it) and it is also
; extracted to {tmp} — see PrepareToInstall for why the previous copy has to be
; captured before files are replaced.
#define PayloadManifest "ib-payload-manifest.json"

[Setup]
; Stable identity: upgrades replace the same install and never create a second
; copy or a second uninstall entry.
AppId={#AppIdValue}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppPublisher}
AppPublisherURL={#AppURL}
AppSupportURL={#AppURL}
VersionInfoVersion={#AppVersion}.0
VersionInfoCompany={#AppPublisher}
VersionInfoDescription={#AppName} Setup
VersionInfoProductName={#AppName}
VersionInfoProductVersion={#AppVersion}

; per-user / lowest privileges / no UAC prompt
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=
DefaultDirName={localappdata}\Programs\{#InstallDirectoryName}
DisableDirPage=no
UsePreviousAppDir=yes
DefaultGroupName={#AppName}
AllowNoIcons=yes
DisableProgramGroupPage=yes
DisableWelcomePage=no
DisableReadyPage=no

; A running instance is stopped by our own helper (friendly, IB-specific);
; Restart Manager's generic "close these programs" dialog is disabled so users
; never see an internal process name.
CloseApplications=no
RestartApplications=no
SetupMutex=InternalBeyondSetupMutex

; Windows 10+ (bundled Node.js 24 requires it); x64 runtime
MinVersion=10.0
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible

LicenseFile=..\LICENSE
OutputDir={#OutputDir}
OutputBaseFilename={#OutputBaseName}-Setup-{#AppVersion}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
SetupLogging=yes
Uninstallable=yes
UninstallDisplayName={#AppName} {#AppVersion}
UninstallDisplayIcon={app}\assets\icons\IB-icon.ico
SetupIconFile=..\assets\icons\IB-icon.ico
ChangesAssociations=no
ChangesEnvironment=no
AllowUNCPath=no
CreateUninstallRegKey=yes

[Languages]
; Chinese first: this is the language ordinary users of this build see by
; default. The .isl is the upstream user-contributed translation, vendored at
; installer\languages\ (see its README for provenance); Default.isl supplies
; any message the translation does not define.
Name: "chinesesimplified"; MessagesFile: "compiler:Default.isl,{#SourcePath}\languages\ChineseSimplified.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; Whole whitelisted payload (already audited by the build script).
Source: "{#StagingDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; Same helper again, extracted on demand by [Code] before files are replaced.
Source: "{#StagingDir}\tools\{#StopHelper}"; DestDir: "{tmp}"; Flags: dontcopy
; The helper derives every stop target from these modules, so it cannot run
; without them. They are extracted next to the helper because neither other
; location can serve PrepareToInstall: on a fresh install {app} is still empty
; (PrepareToInstall runs before any payload is copied), and on an upgrade from a
; pre-P11-3H install the root has neither module — both shipped after 1.0.4.
; service-control.js is the second half of lifecycle.js's own require, and it is
; named here rather than left to chance because a missing one would surface as
; the same silent "cannot stop anything" install abort.
Source: "{#StagingDir}\runtime\component-registry.js"; DestDir: "{tmp}"; Flags: dontcopy
Source: "{#StagingDir}\runtime\component-lifecycle.js"; DestDir: "{tmp}"; Flags: dontcopy
Source: "{#StagingDir}\runtime\service-control.js"; DestDir: "{tmp}"; Flags: dontcopy
; Shared production dependency of service-control.js. It is extracted from the
; same canonical staged bytes because PrepareToInstall runs before {app} exists.
Source: "{#StagingDir}\runtime\host-origin.js"; DestDir: "{tmp}"; Flags: dontcopy
; Used only during upgrades from releases that bundled DSH: migrate the static
; runtime into the per-user extension tree before the payload diff removes it.
Source: "{#StagingDir}\runtime\optional-dsh-runtime.js"; DestDir: "{tmp}"; Flags: dontcopy

[Icons]
; The ONLY user-facing entry point. Users never choose between .cmd / .vbs / .js.
#ifdef InstallerTestMode
; The smoke harness runs under the current Windows token, so WScript shell
; folders still resolve to the real user's profile even when USERPROFILE and
; APPDATA are overridden for child processes. Test-only code constants bind
; shortcuts to those isolated environment roots instead of the host shell paths.
Name: "{code:SmokeProgramsPath}\{#AppName}"; Filename: "{app}\internalbeyond-host.exe"; WorkingDir: "{app}"; IconFilename: "{app}\assets\icons\IB-icon.ico"; Comment: "启动 InternalBeyond"
Name: "{code:SmokeProgramsPath}\卸载 {#AppName}"; Filename: "{uninstallexe}"; Comment: "卸载 InternalBeyond（个人数据会保留）"
Name: "{code:SmokeDesktopPath}\{#AppName}"; Filename: "{app}\internalbeyond-host.exe"; WorkingDir: "{app}"; IconFilename: "{app}\assets\icons\IB-icon.ico"; Comment: "启动 InternalBeyond"; Tasks: desktopicon
#else
Name: "{group}\{#AppName}"; Filename: "{app}\internalbeyond-host.exe"; WorkingDir: "{app}"; IconFilename: "{app}\assets\icons\IB-icon.ico"; Comment: "启动 InternalBeyond"
Name: "{group}\卸载 {#AppName}"; Filename: "{uninstallexe}"; Comment: "卸载 InternalBeyond（个人数据会保留）"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\internalbeyond-host.exe"; WorkingDir: "{app}"; IconFilename: "{app}\assets\icons\IB-icon.ico"; Comment: "启动 InternalBeyond"; Tasks: desktopicon
#endif

[Run]
; Finish page: launch the canonical Tauri host from the same install root.
Filename: "{app}\internalbeyond-host.exe"; WorkingDir: "{app}"; Description: "启动 {#AppName}"; Flags: nowait postinstall skipifsilent
; Zero-touch update (U-D5): the updater helper has already exited and the old
; instance was stopped by StopInternalBeyond above, so the installer is the only
; thing that can put InternalBeyond back. Gated on the /IBRELAUNCH=1 parameter
; the updater passes (U-D3): an ordinary interactive or silent install passes no
; such parameter and therefore launches nothing here, exactly as before.
Filename: "{app}\internalbeyond-host.exe"; WorkingDir: "{app}"; Flags: nowait; Check: WantsRelaunch

[UninstallRun]
; Stop our own instance before program files (including the bundled node.exe)
; are removed. Runs before file deletion; never matches by image name.
Filename: "{app}\runtime\node\node.exe"; Parameters: """{app}\tools\{#StopHelper}"" --root ""{app}"""; Flags: runhidden skipifdoesntexist; RunOnceId: "StopInternalBeyond"

[Code]
var
  { Set when a verified-broken install must not be launched automatically. See
    WantsRelaunch below. Empty means "nothing is known to be wrong". }
  RelaunchBlocked: String;
  { The installed version's own payload manifest, captured before the payload is
    replaced. Empty when the install predates the manifest (every version before
    1.0.5). }
  PreviousManifest: String;

{ Production keeps the existing user-data location. A test-mode binary may opt
  into a harness-owned location; the compile-time guard means a production build
  does not even read this environment variable. }
function InstallerDataRoot(): String;
begin
  Result := ExpandConstant('{localappdata}\InternalBeyond');
#ifdef InstallerTestMode
  if GetEnv('IB_INSTALLER_SMOKE_DATA_DIR') <> '' then
    Result := GetEnv('IB_INSTALLER_SMOKE_DATA_DIR');
#endif
end;

#ifdef InstallerTestMode
{ A process environment override is reliable for the smoke install, while
  WScript.Shell.SpecialFolders continues to point at the real logged-in user's
  folders. Keep test shortcuts entirely under the harness-owned roots. }
function SmokeProgramsPath(Param: String): String;
var
  Root: String;
begin
  Root := GetEnv('APPDATA');
  if Root = '' then
    Root := ExpandConstant('{userprograms}');
  Result := AddBackslash(Root) + 'Microsoft\Windows\Start Menu\Programs\{#AppName}';
end;

function SmokeDesktopPath(Param: String): String;
var
  Root: String;
begin
  Root := GetEnv('USERPROFILE');
  if Root = '' then
    Root := ExpandConstant('{userdesktop}');
  Result := AddBackslash(Root) + 'Desktop';
end;
#endif

{ ── WebView2 production prerequisite (Evergreen per-user policy) ──────────
  Tauri NSIS has a generated bootstrapper, but it is not the production
  installer authority. Existing Inno owns this bounded detect/download/install
  path so a canonical Host install does not depend on the acceptance installer. }
function WebView2KeyPresent(RootKey: Integer; const KeyPath: String): Boolean;
var
  Version: String;
begin
  Version := '';
  Result := RegQueryStringValue(RootKey, KeyPath, 'pv', Version) and (Version <> '');
end;

function WebView2Installed(): Boolean;
begin
  Result :=
    WebView2KeyPresent(HKLM, 'Software\Microsoft\EdgeUpdate\Clients\{#WebView2AppGuid}') or
    WebView2KeyPresent(HKLM64, 'Software\Microsoft\EdgeUpdate\Clients\{#WebView2AppGuid}') or
    WebView2KeyPresent(HKLM, 'Software\WOW6432Node\Microsoft\EdgeUpdate\Clients\{#WebView2AppGuid}') or
    WebView2KeyPresent(HKCU, 'Software\Microsoft\EdgeUpdate\Clients\{#WebView2AppGuid}');
end;

function EnsureWebView2(): String;
var
  PowerShellPath, InstallerPath: String;
  Code: Integer;
begin
  Result := '';
  if WebView2Installed() then exit;

  PowerShellPath := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  InstallerPath := ExpandConstant('{tmp}\MicrosoftEdgeWebView2Setup.exe');
  Log('WebView2 runtime missing; downloading the fixed Microsoft Evergreen bootstrapper.');
  if not FileExists(PowerShellPath) then
  begin
    Result := 'Windows PowerShell is unavailable; cannot bootstrap the WebView2 runtime safely.';
    exit;
  end;

  if not Exec(PowerShellPath,
    '-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command '
    + '"$ErrorActionPreference=''Stop''; $ProgressPreference=''SilentlyContinue''; '
    + '[Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; '
    + 'Invoke-WebRequest -UseBasicParsing -Uri ''{#WebView2BootstrapUrl}'' -OutFile '''
    + InstallerPath + '''"',
    ExpandConstant('{tmp}'), SW_HIDE, ewWaitUntilTerminated, Code) or (Code <> 0) then
  begin
    Result := 'WebView2 bootstrapper download failed (exit code ' + IntToStr(Code) + ').';
    exit;
  end;

  if not FileExists(InstallerPath) then
  begin
    Result := 'WebView2 bootstrapper download completed without producing an installer.';
    exit;
  end;
  Log('WebView2 bootstrapper downloaded; starting the fixed per-user install command.');
  if not Exec(InstallerPath, '/silent /install', ExpandConstant('{tmp}'), SW_HIDE, ewWaitUntilTerminated, Code)
     or (Code <> 0) then
  begin
    Result := 'WebView2 runtime installation failed (exit code ' + IntToStr(Code) + ').';
    exit;
  end;
  if not WebView2Installed() then
    Result := 'WebView2 installer exited successfully but the runtime is still not detected.';
end;

{ ── Relaunch after a zero-touch update (U-D5) ───────────────────────────
  /IBRELAUNCH=1 is passed by the updater helper (U-D3). It is the ONLY way an
  install started by the updater brings the app back, because a silent install
  suppresses the finish-page [Run] entry above. A never-verified runtime is not
  relaunched: the user has just been told the install is broken, and opening an
  app that cannot start would only add a second, more confusing error. }
function WantsRelaunch(): Boolean;
begin
  Result := (ExpandConstant('{param:IBRELAUNCH|0}') = '1') and (RelaunchBlocked = '');
end;

{ ── Product ports ───────────────────────────────────────────────────────
  Defaults are the shipping ports. The IB_* overrides exist so an automated
  smoke run can move the installer's own identity probe onto isolated ports:
  without them the probe would read the developer's instance on 23120/23116
  (harmless but noisy, and impossible to distinguish from the run's own copy). }
function OptionPort(const Name: String; Fallback: Integer): Integer;
var
  Raw: String;
  N: Integer;
begin
  Raw := GetEnv(Name);
  N := StrToIntDef(Raw, 0);
  if (N >= 1) and (N <= 65535) then
    Result := N
  else
    Result := Fallback;
end;

function WebPort(): Integer;
begin
  Result := OptionPort('IB_WEB_PORT', 23120);
end;

function RestartPort(): Integer;
begin
  Result := OptionPort('IB_RESTART_PORT', 23116);
end;

{ ── Locate a usable Node.js: installed runtime first, then PATH ────────── }
function FindNode(): String;
var
  Candidate: String;
begin
  Result := '';
  Candidate := ExpandConstant('{app}\runtime\node\node.exe');
  if FileExists(Candidate) then
  begin
    Result := Candidate;
    exit;
  end;
  Candidate := FileSearch('node.exe', GetEnv('PATH'));
  if Candidate <> '' then
    Result := Candidate;
end;

{ ── Does an InternalBeyond instance answer on its own ports? ───────────── }
function IbIdentityAt(Port: Integer; const Needle: String): Boolean;
var
  Http: Variant;
  Body: String;
begin
  Result := False;
  try
    Http := CreateOleObject('WinHttp.WinHttpRequest.5.1');
    Http.SetTimeouts(700, 700, 700, 700);
    Http.Open('GET', 'http://127.0.0.1:' + IntToStr(Port) + '/health', False);
    Http.Send('');
    Body := Http.ResponseText;
    Result := Pos(Needle, Body) > 0;
  except
    Result := False;
  end;
end;

function IbRunning(): Boolean;
begin
  Result := IbIdentityAt(WebPort(), 'InternalBeyond Web') or IbIdentityAt(RestartPort(), 'InternalBeyond Restart');
end;

{ ── Wait until the bundled runtime can actually be replaced ──────────────
  An in-place upgrade must not race a dying process: Windows keeps node.exe
  mapped for a moment after the process exits, and continuing too early ends in
  "DeleteFile failed; code 5". The shipped helper's --wait-unlock mode opens the
  file for writing, which fails while it is still mapped. Bounded, no guessing. }
function WaitForRuntimeReplaceable(const NodeExe: String; TimeoutMs: Integer): Boolean;
var
  Code: Integer;
  Params, ProbeExe, Helper: String;
begin
  Result := True;
  if not FileExists(NodeExe) then exit;   { fresh install: nothing to unlock }
  Helper := ExpandConstant('{tmp}\{#StopHelper}');
  Params := '"' + Helper + '" --wait-unlock "' + NodeExe + '"'
    + ' --timeout-ms ' + IntToStr(TimeoutMs);

  { The probe must not run from the very file it probes: a running image locks
    itself, which would report "still locked" forever. Run a temp copy. }
  ProbeExe := ExpandConstant('{tmp}\ib-unlock-probe.exe');
  DeleteFile(ProbeExe);
  if FileCopy(NodeExe, ProbeExe, False) then
  begin
    if not Exec(ProbeExe, Params, ExpandConstant('{tmp}'), SW_HIDE, ewWaitUntilTerminated, Code) then
      Result := False
    else
      Result := (Code = 0);
    DeleteFile(ProbeExe);
    exit;
  end;

  { No temp copy possible: fall back to any other Node on PATH. }
  ProbeExe := FileSearch('node.exe', GetEnv('PATH'));
  if ProbeExe = '' then
  begin
    Result := False;
    exit;
  end;
  if not Exec(ProbeExe, Params, ExpandConstant('{tmp}'), SW_HIDE, ewWaitUntilTerminated, Code) then
    Result := False
  else
    Result := (Code = 0);
end;

{ ── Stop our own instance through its control surface ───────────────────
  Returns '' when it is safe to continue, otherwise a user-facing reason. }
function StopInternalBeyond(): String;
var
  Node, Params: String;
  Code: Integer;
begin
  Result := '';
  Node := FindNode();
  if Node = '' then
  begin
    { No runtime available at all (very old copy). If nothing of ours answers,
      there is nothing to stop; otherwise ask the user to close it. }
    if IbRunning() then
      Result := '检测到 InternalBeyond 正在运行，但安装程序找不到可用的运行环境来安全地关闭它。'
        + #13#10#13#10 + '请先手动退出 InternalBeyond（关闭所有 InternalBeyond 窗口，'
        + '并在任务栏右下角确认没有后台进程），然后点击“重试”。'
        + #13#10#13#10 + '安装程序不会强制结束其他程序的进程。';
    exit;
  end;

  ExtractTemporaryFile('{#StopHelper}');
  { The helper loads its stop state machine from these two, and lifecycle.js
    requires service-control.js itself. All three land flat in the temp dir,
    which is candidate 2 of ib-stop.js's module resolution — the only candidate
    that can resolve here. See the [Files] comment above. (No braces in this
    comment: a brace would end it early.) }
  ExtractTemporaryFile('component-registry.js');
  ExtractTemporaryFile('component-lifecycle.js');
  ExtractTemporaryFile('service-control.js');
  ExtractTemporaryFile('host-origin.js');
  { The helper writes what it found to the user's preserved data directory, so a
    failed upgrade leaves a report naming the component, the pid and the state
    instead of only "please close InternalBeyond manually". }
  ForceDirectories(InstallerDataRoot() + '\logs');
  Params := '"' + ExpandConstant('{tmp}\{#StopHelper}') + '"'
    + ' --root "' + ExpandConstant('{app}') + '"'
    + ' --json --timeout-ms 30000'
    + ' --report "' + InstallerDataRoot() + '\logs\upgrade-stop.json"';

  if not Exec(Node, Params, ExpandConstant('{tmp}'), SW_HIDE, ewWaitUntilTerminated, Code) then
  begin
    Result := '无法运行停止助手，安装程序没有继续（不会强制结束任何进程）。'
      + #13#10#13#10 + '请先手动退出 InternalBeyond，然后点击“重试”。';
    exit;
  end;

  if Code <> 0 then
  begin
    Result := 'InternalBeyond 似乎仍在运行，自动关闭没有完全成功。'
      + #13#10#13#10 + '请手动退出 InternalBeyond（包括后台进程），然后点击“重试”。'
      + #13#10#13#10 + '安装程序不会结束其他程序的进程，因此需要您确认一次。';
    exit;
  end;

  { Our instance is down, but the file handle may outlive it for a moment.
    Wait (bounded) until runtime\node\node.exe is genuinely replaceable; if it
    still is not, stop here with a clear message instead of continuing into a
    "DeleteFile failed; code 5" rollback. }
  if not WaitForRuntimeReplaceable(ExpandConstant('{app}\runtime\node\node.exe'), 20000) then
    Result := 'InternalBeyond 的运行环境仍被占用，安装程序没有继续。'
      + #13#10#13#10 + '请关闭 InternalBeyond（包括后台进程），然后点击“重试”。'
      + #13#10#13#10 + '安装程序不会强制覆盖正在使用中的文件。';
end;

function MigrateLegacyDshRuntime(): String; forward;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  NeedsRestart := False;
  { FIRST, before anything else can touch the install directory: record what the
    INSTALLED version owns. The new manifest overwrites it during the file copy,
    and the diff that decides which files this upgrade obsoletes is only
    computable while both lists exist. Done here rather than inside
    StopInternalBeyond so it holds on every path, including the ones where the
    stop cannot run at all. Absent on any install made before 1.0.5 — see
    PruneStalePayload. (No braces in this comment: one would end it early.) }
  PreviousManifest := ExpandConstant('{app}\{#PayloadManifest}');
  if FileExists(PreviousManifest) then
    FileCopy(PreviousManifest, ExpandConstant('{tmp}\{#PayloadManifest}'), False);
  Result := EnsureWebView2();
  if Result <> '' then exit;
  Result := StopInternalBeyond();
  if Result <> '' then exit;
  Result := MigrateLegacyDshRuntime();
end;

function MigrateLegacyDshRuntime(): String;
var
  Node, Script, LegacyRoot, ExtensionRoot, PreviousManifest, Params: String;
  ManifestText: AnsiString;
  Code: Integer;
begin
  Result := '';
  LegacyRoot := ExpandConstant('{app}\runtime\dsh-runtime');
  if not DirExists(LegacyRoot) then exit;
  PreviousManifest := ExpandConstant('{tmp}\{#PayloadManifest}');
  if not FileExists(PreviousManifest) then exit;
  if not LoadStringFromFile(PreviousManifest, ManifestText) then
  begin
    Result := '无法读取旧版载荷清单；安装未继续，现有 DSH 未清理。';
    exit;
  end;
  if Pos('runtime/dsh-runtime/', ManifestText) = 0 then exit;
  if (Pos('runtime/dsh-runtime/runtime-manifest.json', ManifestText) = 0)
     or (Pos('runtime/dsh-runtime/apps/cli/src/bin.ts', ManifestText) = 0)
     or (Pos('runtime/dsh-runtime/node_modules/@deepseek-ai/dsh-web-frontend/dist/index.html', ManifestText) = 0) then
  begin
    Result := '旧版载荷清单中的 DSH Runtime 不完整；安装未继续，旧 DSH 保持原样。';
    exit;
  end;
  ExtensionRoot := ExpandConstant('{localappdata}\InternalBeyond\extensions\dsh-runtime\current');
  Node := ExpandConstant('{app}\runtime\node\node.exe');
  if not FileExists(Node) then
  begin
    Result := '检测到现有 DSH Runtime，但找不到内置运行环境；安装未继续，旧 DSH 未清理。';
    exit;
  end;
  ExtractTemporaryFile('optional-dsh-runtime.js');
  Script := ExpandConstant('{tmp}\optional-dsh-runtime.js');
  Params := '"' + Script + '" --migrate-legacy --source "' + LegacyRoot
    + '" --target "' + ExtensionRoot + '" --previous-manifest "' + PreviousManifest
    + '" --product-version "{#AppVersion}"';
  if not Exec(Node, Params, ExpandConstant('{tmp}'), SW_HIDE, ewWaitUntilTerminated, Code) then
  begin
    Result := '无法安全迁移现有 DSH Runtime；安装未继续，旧 DSH 和 Home Node 数据均未清理。';
    exit;
  end;
  if Code <> 0 then
    Result := '现有 DSH Runtime 未能通过迁移校验；安装已停止，旧 DSH 保持原样。'
      + #13#10#13#10 + '请检查可用磁盘空间后重试。';
end;

{ ── Obsolete payload cleanup (upgrade §7) ───────────────────────────────
  Replacing files by name leaves behind every file the previous version shipped
  and this one does not. The helper deletes exactly the difference between the
  INSTALLED version's own payload manifest and the one being installed — two
  lists of files the product itself declared it owns — and nothing else. It is
  called from ssPostInstall, i.e. only once the new payload is completely in
  place, so a failed copy can never meet a pruned tree.

  An install made before 1.0.5 has no manifest, and in that case the helper
  deletes NOTHING and says so: there is no list of what the old version owned,
  and recognising its files would take a heuristic, not a fact. (Measured for
  1.0.4 -> 1.0.5: none of 1.0.4's 243 files is owned payload absent from 1.0.5,
  so there is nothing to clean either way.)

  A file that could not be deleted is reported and does NOT fail the install:
  the payload is already complete, and refusing to finish over housekeeping would
  be a worse outcome than one dead file. }
procedure PruneStalePayload();
var
  Node, Params, Previous, ReportFile: String;
  Code: Integer;
begin
  Previous := ExpandConstant('{tmp}\{#PayloadManifest}');
  if not FileExists(Previous) then exit;   { nothing recorded → nothing provably obsolete }
  Node := FindNode();
  if Node = '' then exit;
  ReportFile := InstallerDataRoot() + '\logs\upgrade-prune.json';
  Params := '"' + ExpandConstant('{tmp}\{#StopHelper}') + '" --prune-stale'
    + ' --root "' + ExpandConstant('{app}') + '"'
    + ' --manifest "' + ExpandConstant('{app}\{#PayloadManifest}') + '"'
    + ' --previous "' + Previous + '"'
    + ' --report "' + ReportFile + '"';
  if not Exec(Node, Params, ExpandConstant('{tmp}'), SW_HIDE, ewWaitUntilTerminated, Code) then exit;
end;

{ ── Tell the user their data was kept (uninstall never deletes it) ─────── }
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then
    SuppressibleMsgBox('InternalBeyond 已卸载。' + #13#10#13#10
      + '您的个人数据（角色、API 配置、Memory、Diary、朋友圈等）已全部保留，'
      + '不会因为卸载而丢失。' + #13#10#13#10
      + '如需彻底删除，请手动删除此文件夹：' + #13#10
       + InstallerDataRoot(),
      mbInformation, MB_OK, IDOK);
end;

{ ── Post-install runtime validation (B) ─────────────────────────────────
  The bundled runtime must be present AND runnable before the user is ever told
  to start InternalBeyond: a corrupt runtime must fail loudly here instead of
  half-starting later. Never falls back to a system Node. Returns '' when fine,
  otherwise a user-facing reason; a marker file is left for diagnostics. }
{ ── Post-install runtime validation (B) ─────────────────────────────────
  The bundled runtime must be present AND runnable before the user is ever told
  to start InternalBeyond: a corrupt runtime must fail loudly here instead of
  half-starting later. Never falls back to a system Node. Returns '' when fine,
  otherwise a user-facing reason; a marker file is left for diagnostics. }
function ReadFirstLine(const FileName: String): String;
var
  Lines: TArrayOfString;
begin
  Result := '';
  if LoadStringsFromFile(FileName, Lines) and (GetArrayLength(Lines) > 0) then
    Result := Trim(Lines[0]);
end;

function ValidateBundledRuntime(): String;
var
  Node, CmdFile, OutFile, Reported, Pinned: String;
  Code: Integer;
begin
  Result := '';
  Node := ExpandConstant('{app}\runtime\node\node.exe');
  if not FileExists(Node) then
  begin
    Result := '安装完成后找不到内置运行环境（runtime\node\node.exe），安装包可能不完整。';
    exit;
  end;

  CmdFile := ExpandConstant('{tmp}\ib-runtime-check.bat');
  OutFile := ExpandConstant('{tmp}\ib-runtime-check.txt');
  SaveStringToFile(CmdFile,
    '@echo off' + #13#10 +
    '"' + Node + '" --version > "' + OutFile + '" 2>&1' + #13#10, False);
  if (not Exec(ExpandConstant('{cmd}'), '/c "' + CmdFile + '"', ExpandConstant('{tmp}'), SW_HIDE, ewWaitUntilTerminated, Code))
     or (Code <> 0) then
  begin
    Result := '内置运行环境无法启动，安装包可能已损坏。';
    exit;
  end;

  Reported := ReadFirstLine(OutFile);
  Pinned := ReadFirstLine(ExpandConstant('{app}\runtime\node\VERSION'));
  if (Pinned <> '') and (Reported <> ('v' + Pinned)) then
    Result := '内置运行环境版本异常（期望 v' + Pinned + '，实际 ' + Reported + '）。';
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  Problem: String;
begin
  if CurStep = ssPostInstall then
  begin
    Problem := ValidateBundledRuntime();
    if Problem <> '' then
    begin
      RelaunchBlocked := Problem;
      ForceDirectories(ExpandConstant('{app}\logs'));
      SaveStringToFile(ExpandConstant('{app}\logs\runtime-invalid.txt'),
        Problem + #13#10 + '请重新下载安装包后再试。' + #13#10, False);
      SuppressibleMsgBox(Problem + #13#10#13#10 +
        '请重新下载安装包后再试；如果问题重复出现，请联系支持。',
        mbError, MB_OK, IDOK);
    end;
    { After the payload is complete and verified: drop what this release no
      longer owns. Bounded, manifest-driven, never a directory scan. }
    PruneStalePayload();
  end;
end;
