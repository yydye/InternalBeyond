{
  "schemaVersion": 1,
  "phase": "P21-R3-B",
  "dataset": "synthetic-only",
  "authority": "source-backed selectors; evaluated by tests/helpers/memory-value-v2-calibration.js",
  "notes": [
    "This file identifies current canonical producers and their production source anchors.",
    "Numeric defaults and admission thresholds are extracted from production source at runtime; they are not copied from the R3-A report.",
    "Where a producer supplies model input rather than a fixed default, the paired matrix uses the mechanically extracted minimum admitted importance as a representative synthetic case.",
    "The representative rows are not a real producer distribution, mean, or prior.",
    "roleLetterMemories and Auto Memory are excluded."
  ],
  "producers": [
    {
      "id": "manual",
      "sourceFiles": ["assets/js/memory.js"],
      "anchors": ["async function saveMemory()", "rawSource:document.getElementById('mem-f-source').value", "createdBy:'user'"]
    },
    {
      "id": "chat",
      "sourceFiles": ["assets/js/memory.js"],
      "anchors": ["source:isGroup?'group_chat':'chat'", "const memoryData={title,summary,content,source:opts.source||'manual'"]
    },
    {
      "id": "group_chat",
      "sourceFiles": ["assets/js/memory.js"],
      "anchors": ["source:isGroup?'group_chat':'chat'", "const memoryData={title,summary,content,source:opts.source||'manual'"]
    },
    {
      "id": "blog",
      "sourceFiles": ["assets/js/memory.js"],
      "anchors": ["source:'blog',sourceId:postId", "const memoryData={title,summary,content,source:opts.source||'manual'"]
    },
    {
      "id": "letter",
      "sourceFiles": ["assets/js/memory.js"],
      "anchors": ["source:'letter',sourceId:letterId", "const memoryData={title,summary,content,source:opts.source||'manual'"]
    },
    {
      "id": "diary",
      "sourceFiles": ["assets/js/active-diary/diary.js"],
