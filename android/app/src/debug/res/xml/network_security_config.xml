<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY trusted-LAN policy.

  This variant exists for exactly one reason: M1-C must be able to reach a Home
  Node on the LAN at an address that is only known after pairing, and Android
  cannot allowlist an arbitrary address range statically (see the main variant).

  Scope of the concession, stated honestly:
    · it applies to the DEBUG build only — the release variant keeps
      cleartextTrafficPermitted="false" plus its explicit loopback/local list;
    · it does NOT make the connection trusted. Trust is the device token
      (docs/MOBILE_GATEWAY.md §1: "IP is not identity"). Anyone on the LAN can
      read the traffic, which is why the UI says "LAN connection" and never
      "secure" or "encrypted" (Phase 27);
    · user trust anchors are added because a developer may front the Home Node
      with a self-signed TLS terminator while testing.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
