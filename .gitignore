# ── 本地环境 / 缓存（不属于项目源码）────────────────────────────
services/home-node/node_modules/
.venv-vision/
vision/__pycache__/
vision/.cache/
__pycache__/
.pytest_cache/

# 桌面工具本地缓存与临时生成的素材
.reasonix/
Gemini_Generated_Image_*.png

# 本机故障恢复副本与文件认领状态：保留在工作机上，不进入版本库
.dsh/
.dsh-recovery/
.dsh-file-claim/

# 本机运行 / 开发垃圾
.playwright-mcp/
browser-data/
logs/
tmp_ib_probe*.js
_icon_preview.png
.dev-data/

# 阶段验收用的临时工作区（CDP 截图、探针脚本、解压出来的参考实现、对照树）。
# 它是证据，不是源码：**内容保留在工作机上不删**，这条规则只防止未来
# `git add -A` 之类把上百 MB 的截图/参考副本误 stage 进版本库。
# 目前 `git ls-files tmp/` 为 0，规则是向前防护，不是事后清理。
# 注意与已有规则的分工：`tests/.tmp/` 由测试套件自建自删，是另一条独立规则。
/tmp/

# WorkBuddy AI 工具产物（本地记忆/缓存）
.workbuddy-ai/

# 审计脚本生成的机器可读结果（人工报告正文仍提交）
docs/*.results.json

# 发行产物：安装包 / staging / 构建日志通过 GitHub Releases 发布，不进入源码历史
dist/

# Economy v1 策展发布包（P23 Phase 1.1 环境清理确认）：**不是源码**，是
# `node Economy-v1-release/build-package.js` 在仓库根目录跑出来的**快照**——
# 它把当时那份 VERSION / 源码 / 文档复制进 `Economy-v1-release/`，并生成
# `ECONOMY_V1_CHECKSUMS.txt`（152 条，含自身 manifestSha256）与压缩档。
# 判据（已核对）：包内的 `services/home-node/economy-store.js` 与当前源码
# **SHA-256 不同**，后续阶段改过的文件也不会被它收录 —— 也就是说它既不是真源，
# 也已经过期。真源始终是被跟踪的 `services/` `assets/` `tests/` `docs/`。
# 它同样**不是** IB 产品发布链的一部分（见 docs/RELEASE_PIPELINE_AUDIT.md §5/§307）。
# 需要重新取一份就重跑那个脚本（它只写这个目录），所以不需要进版本库：
Economy-v1-release/
InternalBeyond-Economy-v1.tar.gz
InternalBeyond-Economy-v1.tar.gz.sha256

# bundled Node runtime binary: fetched by scripts/update-node-runtime.ps1, never committed
runtime/node/node.exe

# Optional DSH Runtime output: reproducible from the pinned external source by
# scripts/build-dsh-runtime.js, then packaged as an independent ZIP.
runtime/dsh-runtime/

# Test fixtures that must live INSIDE the checkout, so that "which install root
# owns this process?" is answerable the way the product answers it (by command
# line / executable path against the root). Created and removed by the suites.
tests/.tmp/

# Release Builder build outputs (Release Tooling R1). The SOURCE lives in
# tools/release-builder/ and is committed; these two are what `node
# tools/release-builder/build.js` regenerates from it, so they are not history:
#   · the compiled launcher (csc.exe, ~11 KB), which is what the user double-clicks
#   · the self-contained runtime copy the launcher runs (server.js + lib/ + public/)
tools/IB-Release-Builder.exe
tools/release-builder-runtime/
# Dry-run scratch: a dry run must leave no trace, and this is where a log would
# land if one were ever written during one. It never is; the ignore is a guard.
tools/release-builder/.dry-run/

# Tauri 2 build metadata and native build output; source config/capabilities stay tracked.
.tauri-frontend/
src-tauri/target/
src-tauri/gen/

# 本机专用的 Agent / 研究缓存：不是产品源码，绝不进版本库
.dsh-research/
.codegraph/
.ua/
.claude/

# Historical local Dev-only Live2D staging path; never use this inside release assets.
/assets/live2d-dev/
# The proprietary Cubism Core is provided to the release staging tree only after
# the applicable publication rights have been cleared.
/assets/live2d/runtime/live2dcubismcore.min.js
