# ── 本地环境 / 缓存（不属于项目源码）────────────────────────────
.venv-vision/
vision/__pycache__/
vision/.cache/
__pycache__/
.pytest_cache/

# 桌面工具本地缓存与临时生成的素材
.reasonix/
Gemini_Generated_Image_*.png

# 本机故障恢复副本与文件认领状态：保留在工作机上，不进入版本库
.dsh/
.dsh-recovery/
.dsh-file-claim/

# 本机运行 / 开发垃圾
.playwright-mcp/
browser-data/
logs/
tmp_ib_probe*.js
_icon_preview.png

# WorkBuddy AI 工具产物（本地记忆/缓存）
.workbuddy-ai/

# 审计脚本生成的机器可读结果（人工报告正文仍提交）
docs/*.results.json

# 发行产物：安装包 / staging / 构建日志通过 GitHub Releases 发布，不进入源码历史
dist/

# bundled Node runtime binary: fetched by scripts/update-node-runtime.ps1, never committed
runtime/node/node.exe

# Test fixtures that must live INSIDE the checkout, so that "which install root
# owns this process?" is answerable the way the product answers it (by command
# line / executable path against the root). Created and removed by the suites.
tests/.tmp/

# Release Builder build outputs (Release Tooling R1). The SOURCE lives in
# tools/release-builder/ and is committed; these two are what `node
# tools/release-builder/build.js` regenerates from it, so they are not history:
#   · the compiled launcher (csc.exe, ~11 KB), which is what the user double-clicks
#   · the self-contained runtime copy the launcher runs (server.js + lib/ + public/)
tools/IB-Release-Builder.exe
tools/release-builder-runtime/
# Dry-run scratch: a dry run must leave no trace, and this is where a log would
# land if one were ever written during one. It never is; the ignore is a guard.
tools/release-builder/.dry-run/
